#!/usr/bin/env bash
set -euo pipefail

# Prefer the system Zsh on macOS: it is already an approved login shell.
if [[ -x /bin/zsh ]] && grep -qx /bin/zsh /etc/shells 2>/dev/null; then
  zsh_path=/bin/zsh
elif command -v zsh >/dev/null 2>&1; then
  zsh_path="$(command -v zsh)"
else
  printf '[bootstrap] Zsh is unavailable; install it before changing your login shell.\n'
  exit 0
fi

# $SHELL can be inherited or stale; give guidance without mutating the account.
if grep -qx "$zsh_path" /etc/shells 2>/dev/null; then
  printf '[bootstrap] To use Zsh as your account login shell, run:\n'
  printf '  chsh -s %q\n' "$zsh_path"
else
  printf '[bootstrap] Zsh is installed at %s but is not listed in /etc/shells.\n' "$zsh_path"
  printf '[bootstrap] Ask your administrator to add that path to /etc/shells, then run:\n'
  printf '  chsh -s %q\n' "$zsh_path"
fi
printf '[bootstrap] Open a new login session after changing the shell.\n'
